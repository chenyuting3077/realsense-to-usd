+void Mapper::integrateColorWithDepth(torch::Tensor color_frame_t,
+                                     torch::Tensor depth_frame_t,
+                                     torch::Tensor T_L_C_t,
+                                     c10::intrusive_ptr<PySensor> sensor,
+                                     long mapper_id) {
+  CHECK_LT(mapper_id, static_cast<int>(mappers_.size()));
+  ALL_ON_GPU_OR_RETURN(color_frame_t, depth_frame_t);
+
+  if (!checkSizes(T_L_C_t, {4, 4})) {
+    LOG(WARNING) << "Pose tensor size is not correct";
+    return;
+  }
+  if (!checkImageDimensionsEqual(color_frame_t, depth_frame_t)) {
+    LOG(WARNING) << "Color and depth frame sizes do not match";
+    return;
+  }
+  CHECK_EQ(color_frame_t.sizes()[2], nvblox::kRgbNumElements);
+  if (!sensor->isSensorType<nvblox::Camera>()) {
+    LOG(ERROR) << "Color integration only supported for Camera sensors";
+    return;
+  }
+  mappers_[mapper_id]->integrateColor(
+      masked_view_from_tensor<const nvblox::Color>(color_frame_t),
+      masked_view_from_tensor<const float>(depth_frame_t),
+      copy_transform_from_tensor(T_L_C_t),
+      sensor->getNvbloxSensor<nvblox::Camera>());
+}
